          onStageChangeInModal();
        };

        const openEditDealModal = (deal) => {
          editingDealId.value = deal.id;
          dealForm.value = { ...deal };
          dealModalOpen.value = true;
        };

        const onStageChangeInModal = () => {
          const s = stages.value.find(st => st.id === dealForm.value.stage);
          if (s) dealForm.value.probability = s.prob;
        };

        const saveDeal = async () => {
          try {
            if (editingDealId.value) {
              await apiFetch(`/api/deals/${editingDealId.value}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dealForm.value)
              });
              if (dealForm.value.stage === 'won') {
                triggerConfetti();
                showToast('🎉 受注おめでとうございます！');
              } else {
                showToast('案件を更新しました');
              }
            } else {
              await apiFetch('/api/deals', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dealForm.value)
              });
              if (dealForm.value.stage === 'won') {
                triggerConfetti();
                showToast('🎉 受注おめでとうございます！');
              } else {
                showToast('新規案件を登録しました');
              }
            }
            dealModalOpen.value = false;
            await loadBootstrap();
          } catch (e) {
            console.error('Error saving deal:', e);
          }
        };

        const deleteDeal = async (id) => {
          if (!confirm('この案件を削除しますか？')) return;
          try {
            await apiFetch(`/api/deals/${id}`, { method: 'DELETE' });
            dealModalOpen.value = false;
            showToast('案件を削除しました');
            await loadBootstrap();
          } catch (e) {
            console.error('Error deleting deal:', e);
          }
        };

        // Customer Modal
        const openNewCustomerModal = () => {
          editingCustomerId.value = null;
          customerForm.value = { name: '', industry: '', contact_name: '', contact_email: '', contact_phone: '', status: 'active', notes: '' };
          customerModalOpen.value = true;
        };

        const openEditCustomerModal = (c) => {
          editingCustomerId.value = c.id;
          customerForm.value = { ...c };
          customerModalOpen.value = true;
        };

        const saveCustomer = async () => {
          try {
            if (editingCustomerId.value) {
              await apiFetch(`/api/customers/${editingCustomerId.value}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(customerForm.value)
              });
              showToast('取引先情報を更新しました');
            } else {
              await apiFetch('/api/customers', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(customerForm.value)
              });
              showToast('新規取引先を登録しました');
            }
            customerModalOpen.value = false;
            await loadBootstrap();
          } catch (e) {
            console.error('Error saving customer:', e);
          }
        };

        const deleteCustomer = async (id) => {
          if (!confirm('この取引先を削除しますか？関連する案件も削除される場合があります。')) return;
          try {
            await apiFetch(`/api/customers/${id}`, { method: 'DELETE' });
            if (selectedCustomer.value?.id === id) selectedCustomer.value = null;
            showToast('取引先を削除しました');
            await loadBootstrap();
          } catch (e) {
            console.error('Error deleting customer:', e);
          }
        };

        // CSV Import
        const handleFileSelect = (e) => {
          const file = e.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (event) => {
            importCsvText.value = event.target.result;
          };
          reader.readAsText(file);
        };

        const executeImport = async () => {
          try {
            const lines = importCsvText.value.trim().split('\n');
            const items = [];
            for (let i = 0; i < lines.length; i++) {
              const line = lines[i].trim();
              if (!line) continue;
              if (i === 0 && (line.includes('企業名') || line.toLowerCase().includes('name'))) continue;
              const cols = line.split(',').map(c => c.trim().replace(/^["']|["']$/g, ''));
              if (cols[0]) {
                items.push({
                  name: cols[0],
                  industry: cols[1] || '',
                  contact_name: cols[2] || '',
                  contact_email: cols[3] || '',
                  contact_phone: cols[4] || '',
                  status: 'active',
                  notes: cols[5] || ''
                });
              }
            }

            if (items.length === 0) {
              alert('有効なデータが見つかりませんでした。');
              return;
            }

            const res = await apiFetch('/api/import/customers', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ customers: items })
            });
            const data = await res.json();
            showToast(`${data.imported_count} 件の顧客データをインポートしました`);
            showImportModal.value = false;
            importCsvText.value = '';
            await loadBootstrap();
          } catch (e) {
            console.error('Import error:', e);
            alert('インポート中にエラーが発生しました。');
          }
        };

        // Activity Modal
        const openNewActivityModal = () => {
          activityForm.value = {
            customer_id: customers.value[0]?.id || null,
            deal_id: null,
            user_id: currentUserId.value,
            type: 'meeting',
            activity_date: selectedCalendarDate.value || new Date().toISOString().slice(0, 10),
            summary: '',
            details: '',
            next_action: '',
            next_action_date: new Date(Date.now() + 7*86400000).toISOString().slice(0, 10)
          };
          activityModalOpen.value = true;
        };

        const saveActivity = async () => {
          try {
            await apiFetch('/api/activities', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(activityForm.value)
            });
            activityModalOpen.value = false;
            showToast('活動・予定を記録しました');
            await loadBootstrap();
          } catch (e) {
            console.error('Error saving activity:', e);
          }
        };

        const toggleActivity = async (id) => {
          try {
            await apiFetch(`/api/activities/${id}/toggle`, { method: 'PUT' });
            showToast('ToDoステータスを更新しました');
            await loadBootstrap();
          } catch (e) {
            console.error('Error toggling activity:', e);
          }
        };

        const deleteActivity = async (id) => {
          if (!confirm('この活動ログを削除しますか？')) return;
          try {
            await apiFetch(`/api/activities/${id}`, { method: 'DELETE' });
            showToast('活動ログを削除しました');
            await loadBootstrap();
          } catch (e) {
            console.error('Error deleting activity:', e);
          }
        };

        const openMapForCustomer = (cust) => {
          const query = encodeURIComponent(cust.name + (cust.industry ? ' ' + cust.industry : ''));
          const isMacOrIos = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
          const url = isMacOrIos ? `https://maps.apple.com/?q=${query}` : `https://www.google.com/maps/search/?api=1&query=${query}`;
          window.open(url, '_blank');
        };

        const resetDemoData = async () => {
          if (!confirm('デモデータを初期状態にリセットしますか？')) return;
          try {
            await apiFetch('/api/reset-demo', { method: 'POST' });
            showToast('デモデータをリセットしました');
            showSettingsModal.value = false;
            await loadBootstrap();
          } catch (e) {
            console.error('Error resetting demo:', e);
          }
        };

        watch(currentTab, (newTab) => {
          if (newTab === 'dashboard') {
            nextTick(() => renderCharts());
          }
        });

        onMounted(async () => {
          if (isAuthenticated.value) {
            try {
              await loadBootstrap();
            } catch (e) {
              isAuthenticated.value = false;
            }
          }
        });

        return {
          users, customers, deals, activities, stages, analytics,
          currentTab, currentUserId, currentUser, filterUserId, mobilePipelineStage, globalSearchQuery, customerSearchQuery, onlyPendingTodo, toastMessage,
          activeDealsCount, averageProbability, averageWonDealAmount, nextPendingDate,
          todayStr, todayEvents, calendarViewMode, upcomingAgendaDays, isInactiveDeal, copyForLine, appendFeel, setNextActionPreset,
          calendarYear, calendarMonth, selectedCalendarDate, calendarEvents, calendarGridDays, selectedDayEvents, formatSelectedDateHeader,
          prevCalendarMonth, nextCalendarMonth, todayCalendarMonth, openNewActivityForDate,
          tabs, filteredDeals, filteredDealsTotal, filteredCustomers, filteredActivities, pendingActivities, pendingActivitiesCount,
          customerDealsForActivity, customerDeals, customerActivities, selectedCustomer,
          showNeglectedOnly, isCustomerNeglected, getLastContactText, neglectedCustomersCount,
          showQuoteModal, quoteDeal, openQuotationModal, printQuotation, copyQuotationSummary, getUserEmail, getTodayDate, getQuotationNumber,
          isRecordingSpeech, toggleSpeechRecognition, triggerConfetti,
          openMapForCustomer,
          customerAttachments, previewImageSrc, loadCustomerAttachments, uploadCustomerImage, deleteAttachment,
          presetTags, selectedTagFilter, toggleCustomerTag, toggleDealTag, lostReasonPresets, showLostAnalysis, exportVCard,
          showShareModal, copyStatus, copyShareUrl, tunnelUrl, copyTunnelStatus, copyTunnelUrl, openShareModal,
          isAuthenticated, loginPassword, loginError, rememberMe, handleLogin, logout,
          showSettingsModal, pwdChangeForm, pwdChangeError, handleChangePassword, downloadBackup, clearDemoData,
          showImportModal, importCsvText, handleFileSelect, executeImport,
          userModalOpen, userForm, openEditUserModal, saveUser,
          dealModalOpen, editingDealId, dealForm,
          customerModalOpen, editingCustomerId, customerForm,
          activityModalOpen, activityForm,
          formatNumber, getStageHex, getStageLabel, getProbBadgeClass, getActivityIcon, getDealsInStage, getStageTotal, getDealsForCustomer, getDealsForUser,
          openCustomerDetail, openCustomerDetailById, openNewDealForCustomer, openNewActivityForCustomer,
          onDragStartDeal, onDropDeal, updateDealStage,
          openNewDealModal, openNewDealModalWithStage, openEditDealModal, onStageChangeInModal, saveDeal, deleteDeal,
          openNewCustomerModal, openEditCustomerModal, saveCustomer, deleteCustomer,
          openNewActivityModal, saveActivity, toggleActivity, deleteActivity, resetDemoData
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
